# Copy this file to .env and fill in your own values:
#   cp env.example .env
#
# Nobody needs to touch code to switch providers -- just change LLM_PROVIDER
# and fill in the matching API key below.

# --- LLM provider: "gemini" | "openai" | "anthropic" ---
LLM_PROVIDER=gemini

# Only the block matching LLM_PROVIDER needs a real key. Model names are
# overridable per-provider so a newer/cheaper model doesn't require a code change.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/spec_clarity

# --- Server ---
PORT=3000

# Local directory the containerized app can browse via the header's folder
# picker (mounted read-only at the same path inside the container). Only
# used by docker-compose.yml -- ignored when running the backend directly
# on the host (npm run dev), which can already browse your whole filesystem.
HOST_REPOS_DIR=/absolute/path/to/your/repos

# --- Chat layer (CopilotKit) ---
# Same LLM_PROVIDER/keys above power the chat's conversational routing too.
# Off by default, matching this app's existing privacy posture (PAT never
# persisted, etc.) -- flip to false if you want CopilotKit's own usage telemetry.
COPILOTKIT_TELEMETRY_DISABLED=true

# --- Observability (optional) ---
# Traces every pipeline-stage LLM call (clarify/edgeCases/classifier/
# docGenerator) to a Langfuse instance -- one request in, one "intake" or
# "analysis" trace out, with each stage's prompt/completion nested under it.
# Leave both keys blank to disable entirely; nothing else changes.
# Get keys from your Langfuse project settings (e.g. http://localhost:3001
# if running Langfuse locally via docker compose -- Settings > API Keys).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3001
